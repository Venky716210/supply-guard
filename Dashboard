with tab2:
    st.subheader("🌡️ Climate & Geopolitical Signals")
    col1, col2, col3 = st.columns(3)
    
    avg_geo = data['Geopolitical_Risk'].mean()
    avg_climate = data['Climate_Anomaly'].mean()
    
    with col1:
        st.metric("Geopolitical Risk", f"{avg_geo:.2f}", "🔴 High" if avg_geo > 0.6 else "🟠 Medium")
    with col2:
        st.metric("Climate / Weather Risk", f"{avg_climate:.2f}", "🔴 High" if avg_climate > 0.6 else "🟠 Medium")
    with col3:
        st.metric("Avg Overall Risk", f"{data['Risk_Score'].mean():.1f}")

    st.markdown("### Supplier-wise Status")
    for _, row in data.iterrows():
        with st.container(border=True):
            st.markdown(f"**{row['Supplier']}** ({row['Country']})")
            col_a, col_b, col_c = st.columns(3)
            with col_a:
                st.metric("Geopolitical", f"{row['Geopolitical_Risk']:.2f}", 
                         "🔴" if row['Geopolitical_Risk'] > 0.65 else "🟠" if row['Geopolitical_Risk'] > 0.4 else "🟢")
            with col_b:
                st.metric("Climate/Weather", f"{row.get('Climate_Anomaly', 0):.2f} | {row.get('Weather_Condition', 'N/A')}", 
                         "🔴" if row.get('Climate_Anomaly', 0) > 0.65 else "🟠" if row.get('Climate_Anomaly', 0) > 0.4 else "🟢")
            with col_c:
                st.metric("Overall Risk", f"{row.get('Risk_Score', 0):.1f}", row.get('Risk_Level', 'High'))

