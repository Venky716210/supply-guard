    fig = px.bar(data.sort_values('Risk_Score', ascending=False), 
                 x='Supplier', y='Risk_Score', color='Risk_Level',
                 color_discrete_map={'Low':'#22c55e', 'Medium':'#eab308', 'High':'#ef4444'})
