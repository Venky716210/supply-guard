import random
import os

# ===================== STYLING =====================
st.set_page_config(page_title="Xebia SupplyGuard", layout="wide", page_icon="🛡️")

st.markdown("""
    <style>
    .main {background: linear-gradient(135deg, #0f172a 0%, #1e2937 100%);}
