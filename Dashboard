""", unsafe_allow_html=True)

st.title("🛡️ Xebia SupplyGuard")
st.markdown("### AI-Powered Supply Chain Disruption Early Warning System")

# ===================== LOAD DATA =====================
if not os.path.exists("data"):
    os.makedirs("data")

@st.cache_data
def load_data():
    data_path = "data/suppliers_data.csv"
    if os.path.exists(data_path):
        df = pd.read_csv(data_path)
    else:
        st.error(" Data file not found! Please make sure suppliers_data.csv exists in the 'data' folder.")
        st.stop()
    
    # Calculate Risk_Level if it doesn't exist
    if 'Risk_Level' not in df.columns:
        df['Risk_Score'] = (
            df.get('Geopolitical_Risk', 0) * 0.35 +
            df.get('Climate_Anomaly', 0) * 0.30 +
            df.get('Transport_Risk', 0) * 0.20 +
            df.get('Demand_Fluctuation', 0)/100 * 0.15
        ) * 100
        df['Risk_Score'] = df['Risk_Score'].round(1)
        df['Risk_Level'] = pd.cut(df['Risk_Score'], bins=[0,40,65,100], labels=['Low', 'Medium', 'High'])
    
    return df

data = load_data()

# ===================== SIDEBAR =====================
st.sidebar.markdown("### 🛠️ Controls")
risk_threshold = st.sidebar.slider("🚨 Risk Alert Threshold (%)", 30, 90, 65)

if st.sidebar.button("🔄 Refresh Signals", use_container_width=True):
    st.rerun()

# ===================== HEADER =====================
c1, c2, c3, c4 = st.columns(4)
c1.metric("Overall Risk", "HIGH 🔴", "↑ 28%")

