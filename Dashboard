with tab4:
    st.subheader("🗺️ Live World Risk Map")
    m = folium.Map(location=[20, 0], zoom_start=2, tiles="CartoDB dark_matter")
    for _, row in data.iterrows():
        color = "red" if row.get('Risk_Score', 0) > 65 else "orange" if row.get('Risk_Score', 0) > 40 else "green"
        folium.Marker(
            location=[random.uniform(8, 55), random.uniform(-100, 120)],
            popup=f"{row['Supplier']}<br>Risk: {row.get('Risk_Score', 0)}",
            icon=folium.Icon(color=color)
        ).add_to(m)
    st_folium(m, width=1300, height=600)

with tab5:
    st.subheader("🤖 AI Copilot")
    st.caption("Ask questions like: 'Risk for India?' or 'Climate in Malaysia?'")

    if "messages" not in st.session_state:
        st.session_state.messages = [{"role": "assistant", "content": "Hi! Ask me about climate, geopolitical risks, or specific suppliers."}]

    for msg in st.session_state.messages:
        with st.chat_message(msg["role"]):
            st.write(msg["content"])

    if prompt := st.chat_input("Ask your question..."):
        st.session_state.messages.append({"role": "user", "content": prompt})
        with st.chat_message("user"):
            st.write(prompt)

        lower = prompt.lower()
        if "india" in lower or "foxconn" in lower or "tata" in lower:
            response = "Foxconn (India) and Tata Steel are at **High Risk** due to high Geopolitical Risk and Heavy Rain conditions."
        elif "germany" in lower or "bosch" in lower:
            response = "Bosch (Germany) is currently in **Low Risk** zone with normal weather conditions."
        elif "malaysia" in lower or "intel" in lower:
            response = "Intel (Malaysia) has **High Climate Risk** due to flooding (Climate Anomaly: 0.82)."
        elif "climate" in lower or "weather" in lower:
            response = "Climate anomalies are high in India and Malaysia. Flooding and heavy rain are major concerns."
        else:
            response = "The main risks right now are driven by **Climate Conditions** and **Geopolitical Events** in Asia."

        st.session_state.messages.append({"role": "assistant", "content": response})
        with st.chat_message("assistant"):
            st.write(response)

